generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Message {
  id        Int      @id @default(autoincrement())
  body      String   @db.VarChar(280)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("guestbook_messages")
}
